# Copy to .env — docker-compose reads it automatically.
#   cp .env.example .env

# Host port to publish the server on — maps to the container's fixed internal 3000.
# (For a non-Docker local run, this is the port the Node server listens on directly.)
# Default 3000.
PORT=3000

# Root directory of the rules markdown. Docker sets this to /app/rules
# automatically (see docker-compose.yml), so leave it unset for Docker.
# For a non-Docker local run, point it at your rules dir:
#   export RULES_DIR="$(pwd)/host_rules"
# RULES_DIR=

# Set a strong token to enable Bearer auth on /mcp:
#   echo "MCP_AUTH_TOKEN=$(openssl rand -hex 32)" >> .env
# Multiple tokens (e.g. per client / rotation) can be comma-separated:
#   MCP_AUTH_TOKEN=token-a,token-b
# .env is gitignored — never commit real tokens. Empty = unauthenticated.
MCP_AUTH_TOKEN=

# Extra allowed browser Origins for DNS-rebinding protection (comma-separated).
# Loopback origins and requests without an Origin (native clients like the
# Claude Code CLI) are always allowed, so leave this empty for local use.
# When connecting from Claude Code Web, add its origin, e.g.:
#   MCP_ALLOWED_ORIGINS=https://claude.ai
MCP_ALLOWED_ORIGINS=
